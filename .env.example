# Salin file ini menjadi .env.local dan isi dengan credential Anda.
# Untuk development lokal: jalankan `npx supabase start` lalu isi nilai dari
# output `npx supabase status` (Publishable = ANON, Secret = SERVICE ROLE).

# Supabase (publik — aman untuk frontend/browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Service role — HANYA untuk server (Server Actions / route handler).
# JANGAN pernah dibocorkan ke frontend atau di-commit ke git.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here